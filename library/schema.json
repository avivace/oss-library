{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSS Library Entry",
  "type": "object",
  "required": ["resources"],
  "properties": {
    "description": { "type": "string" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["type", "title", "authors", "open_access", "links"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["book", "report", "conference-paper", "preprint"] },
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
          "description": "Publication date: YYYY-MM-DD, or YYYY-MM / YYYY when only that is known"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true,
          "description": "Lowercase topic tags, e.g. ospo"
        },
        "open_access": { "type": "boolean" },
        "license": {
          "type": ["string", "null"],
          "description": "SPDX identifier (e.g. CC-BY-4.0), or null if proprietary/unknown"
        },
        "links": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "asin": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$",
          "description": "Amazon product code (ASIN; ISBN-10 for books), used to build the affiliate link"
        }
      }
    }
  }
}
